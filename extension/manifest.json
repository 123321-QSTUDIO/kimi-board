{
  "manifest_version": 3,
  "name": "Kimi Board · Token 用量看板",
  "version": "2.0.0",
  "description": "在 Kimi Code WebUI 侧栏实时显示本账期 token 用量与等效费用（含 cc-switch 合并的 KimiCode 用量），并可选把官网月额度同步给本机看板（凭据不出浏览器）。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://www.kimi.com/*",
    "http://127.0.0.1:8321/*",
    "http://localhost:8321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:58627/*",
        "http://127.0.0.1:58628/*",
        "http://127.0.0.1:58629/*",
        "http://127.0.0.1:58630/*",
        "http://localhost:58627/*",
        "http://localhost:58628/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
